# Образ для прогона тестов. База и шрифтовые пакеты — как в проде,
# иначе freetype отрисует иначе и эталоны разойдутся на ровном месте.
FROM --platform=linux/amd64 python:3.11-slim

RUN apt-get update && apt-get install -y \
    fonts-dejavu-core \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest==8.0.0
